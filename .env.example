# Base URL for API calls.
#
# Leave as /api in development: vite proxies /api -> http://localhost:8000
# (the gateway), so the browser stays on one origin and CORS never comes up.
#
# For a build served separately from the API, set the gateway's full URL:
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=/api
